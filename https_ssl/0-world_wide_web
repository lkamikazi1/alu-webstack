#!/usr/bin/env bash
# Display info about the subdomains of a domain

get_info() {
dig "$2.$1" | grep -A1 'ANSWER SECTION:' | awk -v sub="$2" 'NR==2 {print "The subdomain " sub " is a " $4 " record and points to "$5}'
}

if [ "$#" -eq 1 ]; then
for s in www 13.135.67.229 35.177.170.195 3.8.133.227; do
get_info "$1" "$s"
done
else
get_info "$1" "$2"
fi
